+    /// <summary>
+    /// Idempotent backfill: set Title/Markdown/Excerpt only when Markdown is currently empty.
+    /// </summary>
+    [HttpPost("markdown-backfill")]
+    [RequestSizeLimit(50L * 1024 * 1024)]
+    public async Task<ActionResult<object>> MarkdownBackfill(
+        [FromBody] MarkdownBackfillBatchCommand command,
+        CancellationToken ct)
+    {
+        if (command is null || command.RunId == Guid.Empty || command.Pages is null || command.Pages.Count == 0)
+            return BadRequest("runId and pages are required");
+        if (command.Pages.Count > 100)
+            return BadRequest("at most 100 pages per batch");
+
+        var updates = command.Pages
+            .Where(p => p.PageId != Guid.Empty && !string.IsNullOrWhiteSpace(p.Markdown))
+            .Select(p => (p.PageId, p.Title, p.Markdown, p.Excerpt))
+            .ToList();
+
+        var modified = await _mongo.BackfillPageMarkdownBatchAsync(command.RunId, updates, ct);
+        return Ok(new { count = modified, requested = updates.Count });
+    }
+
