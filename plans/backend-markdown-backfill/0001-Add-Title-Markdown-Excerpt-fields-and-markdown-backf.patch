+    public async Task<int> BackfillPageMarkdownBatchAsync(
+        Guid runId,
+        IReadOnlyList<(Guid PageId, string? Title, string? Markdown, string? Excerpt)> updates,
+        CancellationToken ct = default)
+    {
+        if (runId == Guid.Empty) throw new ArgumentException("runId is required", nameof(runId));
+        if (updates == null || updates.Count == 0)
+            throw new ArgumentException("updates are required", nameof(updates));
+
+        try
+        {
+            var collection = _db.GetCollection<GeekCrawlerPage>("crawl_pages");
+            var now = DateTimeOffset.UtcNow;
+            var models = new List<WriteModel<GeekCrawlerPage>>(updates.Count);
+
+            foreach (var u in updates)
+            {
+                if (u.PageId == Guid.Empty) continue;
+                if (string.IsNullOrWhiteSpace(u.Markdown)) continue;
+
+                var filter = Builders<GeekCrawlerPage>.Filter.And(
+                    Builders<GeekCrawlerPage>.Filter.Eq(p => p.RunId, runId),
+                    Builders<GeekCrawlerPage>.Filter.Eq(p => p.Id, u.PageId),
+                    Builders<GeekCrawlerPage>.Filter.Or(
+                        Builders<GeekCrawlerPage>.Filter.Eq(p => p.Markdown, null),
+                        Builders<GeekCrawlerPage>.Filter.Eq(p => p.Markdown, "")));
+
+                var update = Builders<GeekCrawlerPage>.Update
+                    .Set(p => p.Title, u.Title)
+                    .Set(p => p.Markdown, u.Markdown)
+                    .Set(p => p.Excerpt, u.Excerpt)
+                    .Set(p => p.MarkdownBackfilledAt, now);
+
+                models.Add(new UpdateOneModel<GeekCrawlerPage>(filter, update));
+            }
+
+            if (models.Count == 0) return 0;
+
+            var result = await collection.BulkWriteAsync(models, cancellationToken: ct);
+            return (int)result.ModifiedCount;
+        }
+        catch (Exception ex)
+        {
+            _logger.LogError(ex, "Failed to backfill markdown for run {RunId}", runId);
+            throw;
+        }
+    }
+
