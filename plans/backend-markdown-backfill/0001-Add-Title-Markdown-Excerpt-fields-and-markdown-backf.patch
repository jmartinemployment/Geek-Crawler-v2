+    [HttpPost("runs/{runId:guid}/pages/markdown-backfill")]
+    [RequestSizeLimit(MaxPageBatchBytes)]
+    public async Task<IActionResult> MarkdownBackfill(
+        Guid runId,
+        [FromBody] IngestMarkdownBackfillRequest request,
+        CancellationToken ct)
+    {
+        if (!_user.IsAuthenticated) return Unauthorized();
+        if (!await OwnsRunAsync(runId, ct).ConfigureAwait(false)) return NotFound();
+        if (request?.Pages is null || request.Pages.Count == 0)
+            return BadRequest("pages are required");
+        if (request.Pages.Count > 100)
+            return BadRequest("at most 100 pages per batch");
+
+        var items = request.Pages
+            .Select(p => new GeekCrawlerMarkdownBackfillItemCommand(
+                p.PageId,
+                p.Title,
+                p.Markdown,
+                p.Excerpt))
+            .ToList();
+
+        try
+        {
+            var result = await _repo.BackfillPageMarkdownBatchAsync(
+                new GeekCrawlerMarkdownBackfillBatchCommand(runId, items),
+                ct).ConfigureAwait(false);
+            return Ok(result);
+        }
+        catch (HttpRequestException ex)
+        {
+            return StatusCode(StatusCodes.Status502BadGateway, ex.Message);
+        }
+    }
+
