{
  "name": "geek-crawler-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Geek-Crawler v2 — Crawlee CheerioCrawler raw HTML pipeline (standalone; does not modify v1)",
  "scripts": {
    "build": "tsc",
    "crawl": "tsx src/cli.ts crawl",
    "serve": "tsx src/cli.ts serve",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "test:integration": "tsx --test tests/**/*.test.ts",
    "test:all": "npm test && npm run test:integration",
    "check:fail-closed": "node scripts/check-fail-closed.mjs",
    "web:dev": "npm run dev --prefix web",
    "web:build": "npm run build --prefix web"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "cheerio": "^1.0.0-rc.12",
    "crawlee": "^3.18.1",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
