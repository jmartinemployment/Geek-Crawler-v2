# Egress
EGRESS_MODE=off

# Persist via GeekAPI only (required — no local authority mode)
GEEK_API_URL=https://api.geekatyourspot.com
GEEK_BACKEND_API_KEY=
GEEK_USER_ID=

# Crawl tuning
# MIN_CONCURRENCY=1
# MAX_CONCURRENCY=8

# Phase 4: ngrok / SOCKS
# EGRESS_MODE=proxy
# PROXY_URL=socks5://127.0.0.1:1080

# DATA_DIR=./data

# Local extract cache: the clean fragment and typed blocks, under
# DATA_DIR/extract-cache/<runId>/. Diagnostics only — nothing reads it to decide
# what to crawl, resume or dedup. It exists so a chunker can be tuned offline
# against a saved corpus instead of re-fetching the same sites. Set to 0 to disable.
# EXTRACT_CACHE=1
