# Egress
EGRESS_MODE=off

# Persist via GeekAPI → GeekRepository → Hostinger Mongo (required path)
# GEEK_API_URL=https://api.geekatyourspot.com
# GEEK_BACKEND_API_KEY=   # same key as GeekAPI Railway env GEEK_BACKEND_API_KEY
# GEEK_USER_ID=           # your Geek user GUID (X-Geek-User-Id)

# Markdown backfill (after Backend patch applied):
# npm run backfill-markdown -- --run-id <guid> --dry-run
# npm run backfill-markdown -- --run-id <guid>
# npm run backfill-markdown -- --all-runs --dry-run

# Also write local data/ mirrors when using GeekAPI (default: Mongo only when API env set)
# KEEP_LOCAL_DATA=1

# Crawl tuning
# MIN_CONCURRENCY=1
# MAX_CONCURRENCY=8
# PLAYWRIGHT_MAX_CONCURRENCY=1

# Phase 4: ngrok / SOCKS
# EGRESS_MODE=proxy
# PROXY_URL=socks5://127.0.0.1:1080

# DATA_DIR=./data
