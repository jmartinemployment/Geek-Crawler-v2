# Crawlee HTTP API (BFF control plane)
CRAWLEE_API_URL=http://127.0.0.1:8787

# App origin for OAuth redirect (must match GeekOAuth client redirect URIs)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_URL=https://auth.geekatyourspot.com
NEXT_PUBLIC_OAUTH_CLIENT_ID=geek-crawler

# GeekAPI (required for authoritative crawl reads)
GEEK_API_URL=https://api.geekatyourspot.com
NEXT_PUBLIC_GEEK_API_URL=https://api.geekatyourspot.com

# Optional override for SignalR hub URL
# NEXT_PUBLIC_GEEK_CRAWLER_HUB_URL=https://api.geekatyourspot.com/hubs/geek-crawler-realtime

# Same credentials as crawler .env.local
GEEK_BACKEND_API_KEY=
GEEK_USER_ID=
